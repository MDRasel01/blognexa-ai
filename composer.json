{
  "name": "blognexa/blognexa-ai",
  "description": "BlogNexa AI - Production WordPress Content Intelligence & Blog Automation Plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "BlogNexa Engineering Team",
      "email": "engineering@blognexa.ai"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "BlogNexaAI\\": "app/"
    },
    "files": [
      "config/constants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BlogNexaAI\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}

